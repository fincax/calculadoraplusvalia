# URL pública del sitio (SEO: canónicas, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://fincax.es

# Número de WhatsApp de FINCAX en formato internacional sin "+" (opcional).
# Si no se define, el botón de WhatsApp no se muestra.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─────────────────────────────────────────────────────────────────────────
# Destino de los leads del formulario. Todas las vías son opcionales y se
# intentan a la vez: basta con configurar UNA para no perder ningún contacto.
# ─────────────────────────────────────────────────────────────────────────

# 1) Email por SMTP (recomendado). Con Gmail: crea una "contraseña de
#    aplicación" (Cuenta Google → Seguridad → Verificación en 2 pasos →
#    Contraseñas de aplicaciones) y úsala como LEAD_SMTP_PASS.
LEAD_SMTP_HOST=          # p. ej. smtp.gmail.com
LEAD_SMTP_PORT=587       # 587 (STARTTLS) o 465 (SSL, con LEAD_SMTP_SECURE=true)
LEAD_SMTP_SECURE=false
LEAD_SMTP_USER=          # tu dirección de correo
LEAD_SMTP_PASS=          # la contraseña de aplicación
LEAD_TO=fincaxsevilla@gmail.com   # a quién llegan los avisos
LEAD_FROM=               # remitente (por defecto, LEAD_SMTP_USER)

# 2) Copia de seguridad en un fichero del servidor (siempre recomendable).
LEAD_LOG_FILE=           # por defecto ./leads.jsonl en la carpeta de la app

# 3) Webhook a un CRM/automatización (Zapier/Make), opcional.
LEAD_WEBHOOK_URL=
